APP_NAME=UrbanSole
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=urbansole
# DB_USERNAME=root
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=localhost:4200,127.0.0.1:4200
FRONTEND_URL=http://localhost:4200

# Semana 15: Automatización de Procesos y Webhooks con n8n
N8N_WEBHOOK_URL=http://localhost:5678/webhook/urbansole
N8N_WEBHOOK_ENABLED=true
N8N_NOTIFY_EMAIL=admin@urbansole.com
